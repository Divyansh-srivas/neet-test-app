# Backend specific configuration
PORT=3000

# Redis Configuration (Required for BullMQ)
# If running locally via Docker: REDIS_HOST=127.0.0.1, REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Supabase Credentials (Required to save jobs and questions)
# Use your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# You can use the Anon Key, but Service Role Key is recommended for the backend worker
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API Key (Required for AI Extraction)
VITE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=4
PDF_CHUNK_SIZE=2
